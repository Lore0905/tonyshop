SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Alternative to a static token:
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-10
APP_HOST=127.0.0.1
APP_PORT=8770

# API ufficiale fornitore: lettura products e combinations.
# La chiave può essere ereditata dal .env nella cartella superiore.
AUTOFANTASY_WEBSERVICE_KEY=
# Facoltativo: ID lingua realmente disponibile nel fornitore.
# Vuoto = lingua predefinita dell'API. Non presumere che 1 sia italiano.
AUTOFANTASY_LANGUAGE_ID=
